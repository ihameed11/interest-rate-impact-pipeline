# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore, so it is never uploaded to GitHub.

# Database login for the local PostgreSQL container
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=change_me
POSTGRES_DB=finance

# Azure Blob Storage (Phase 0, Step 6)
# Storage account name and one of its access keys, from the Azure portal:
# Storage account -> Security + networking -> Access keys
AZURE_STORAGE_ACCOUNT=your_storage_account_name
AZURE_STORAGE_KEY=your_access_key

# SEC downloads (Phase 1)
# The SEC asks every program that downloads its data to say who it is:
# your name and a contact email.
SEC_USER_AGENT=Your Name your.email@student.ncirl.ie
