<?xml version="1.0" encoding="UTF-8"?>
<!-- HDFS (storage) settings. -->
<configuration>
  <!-- Keep every block of every file on 2 DataNodes.
       If one DataNode stops, the data is still available. -->
  <property>
    <name>dfs.replication</name>
    <value>2</value>
  </property>
  <property>
    <name>dfs.namenode.name.dir</name>
    <value>file:///data/namenode</value>
  </property>
  <property>
    <name>dfs.datanode.data.dir</name>
    <value>file:///data/datanode</value>
  </property>
  <!-- Docker containers get new addresses on restart, so do not
       insist that a DataNode's address matches a known host name. -->
  <property>
    <name>dfs.namenode.datanode.registration.ip-hostname-check</name>
    <value>false</value>
  </property>
  <!-- A learning cluster: no user permission checks on files. -->
  <property>
    <name>dfs.permissions.enabled</name>
    <value>false</value>
  </property>
</configuration>
